Screen {
    background: $background;
    color: $foreground;
}

#masthead {
    height: 1;
    background: $panel;
    color: $primary;
    text-style: bold;
}

TabbedContent, ContentSwitcher, TabPane, ParseView, ChatView, ExportsView {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

Tabs {
    background: $surface;
    color: $text-muted;
}

.connection {
    height: auto;
    min-height: 1;
    max-height: 3;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

.section-title {
    height: 1;
    color: $foreground;
    text-style: bold;
}

#parse-layout {
    height: 1fr;
}

#parse-controls {
    padding: 1;
    width: 41%;
    background: $surface;
    overflow-y: auto;
}

#preview-panel {
    padding: 1;
    width: 1fr;
    background: $background;
}

#preview-toolbar, #chat-toolbar, .field-row, .buttons {
    height: auto;
    align-vertical: middle;
}

#preview-toolbar .section-title {
    width: 1fr;
}

#export-format {
    width: 19;
    margin-left: 1;
}

#preview-mode {
    width: 20;
}

#preview-hint {
    color: $text-muted;
    height: auto;
}

#render-scroll, #raw-preview, #chat-scroll, #export-list {
    height: 1fr;
    min-height: 2;
}

#rendered MarkdownTableContent > .header, #rendered MarkdownTableContent > .cell {
    text-overflow: fold;
}

Input, Select, TextArea, SelectionList {
    background: $panel;
}

Input, SelectCurrent, TextArea {
    border: tall $border-blurred;
}

Input:focus, TextArea:focus, Select:focus SelectCurrent, SelectionList:focus {
    border: tall $border;
}

.field-row Input {
    width: 1fr;
}

Button {
    min-width: 8;
    margin-right: 1;
}

Button:focus {
    text-style: bold reverse;
}

#parse-progress {
    height: 1;
    color: $primary;
}

#parse-feedback, #chat-feedback, #delete-feedback {
    height: auto;
    max-height: 4;
    overflow-y: auto;
    color: $warning;
}

#chat-toolbar .section-title {
    width: 8;
}

#chat-model {
    width: 1fr;
    margin-right: 1;
}

#prompt {
    height: 5;
}

#transcript {
    padding: 0 1;
}

#export-list {
    border: tall $border-blurred;
}

ModalScreen {
    align: center middle;
    background: #000a;
}

.dialog {
    background: $surface;
    border: solid $border;
    padding: 0 1;
    width: 85%;
    max-width: 94;
    height: 85%;
}

.dialog-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

.dialog-body, #source-tree {
    height: 1fr;
}

#browse-path {
    height: auto;
    max-height: 2;
}

.narrow #parse-layout {
    layout: vertical;
}

.narrow #parse-controls, .narrow #preview-panel {
    width: 100%;
    padding: 0 1;
}

.narrow #parse-controls {
    height: auto;
    max-height: 11;
}

.narrow #preview-panel {
    height: 1fr;
}

.narrow #parse-controls Input {
    height: 1;
    border: none;
    padding: 0 1;
}

.narrow #parse-controls Input:focus {
    border-left: solid $border;
    background: $surface-active;
}

.narrow #parse-controls Button, .narrow #parse-controls Button:focus {
    height: 1;
    border: none;
}

.narrow #parse-controls .buttons {
    margin-top: 1;
}

.narrow #preview-mode {
    width: 20;
}

.narrow #prompt {
    height: 4;
}
