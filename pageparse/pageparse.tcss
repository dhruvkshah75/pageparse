Screen {
    background: #101623;
    color: #e2e9fb;
}

#masthead {
    height: 1;
    background: #1b3240;
    color: #83e1c9;
    text-style: bold;
}

TabbedContent, ContentSwitcher, TabPane, ParseView, ChatView, ExportsView {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

Tabs {
    background: #172131;
    color: #b7c4dc;
}

Footer {
    background: #1b3240;
}

.connection {
    height: auto;
    min-height: 1;
    max-height: 3;
    padding: 0 1;
    background: #202d40;
    color: #c2d1eb;
}

.section-title {
    height: 1;
    color: #83e1c9;
    text-style: bold;
}

#parse-layout {
    height: 1fr;
}

#parse-controls {
    padding: 1;
    width: 41%;
    background: #151e2d;
    overflow-y: auto;
}

#preview-panel {
    padding: 1;
    width: 1fr;
    background: #101927;
}

#preview-toolbar, #chat-toolbar, .field-row, .buttons {
    height: auto;
    align-vertical: middle;
}

#preview-toolbar .section-title {
    width: 1fr;
}

#preview-mode {
    width: 20;
}

#preview-hint {
    color: #acbdd7;
    height: auto;
}

#render-scroll, #raw-preview, #chat-scroll, #export-list {
    height: 1fr;
    min-height: 2;
}

Input, Select, TextArea, SelectionList {
    background: #202d40;
}

Input, SelectCurrent, TextArea {
    border: tall #435472;
}

Input:focus, TextArea:focus, Select:focus SelectCurrent, SelectionList:focus {
    border: tall #83e1c9;
}

.field-row Input {
    width: 1fr;
}

Button {
    min-width: 8;
    margin-right: 1;
}

Button:focus {
    text-style: bold reverse;
}

#parse-progress {
    height: 1;
    color: #83e1c9;
}

#parse-feedback, #chat-feedback, #delete-feedback {
    height: auto;
    max-height: 4;
    overflow-y: auto;
    color: #eac88d;
}

#chat-toolbar .section-title {
    width: 8;
}

#chat-model {
    width: 1fr;
    margin-right: 1;
}

#prompt {
    height: 5;
}

#transcript {
    padding: 0 1;
}

#export-list {
    border: tall #435472;
}

ModalScreen {
    align: center middle;
    background: #000a;
}

.dialog {
    background: #1d293c;
    border: solid #6db9ab;
    padding: 0 1;
    width: 85%;
    max-width: 94;
    height: 85%;
}

.dialog-title {
    height: 1;
    color: #83e1c9;
    text-style: bold;
}

.dialog-body, #source-tree {
    height: 1fr;
}

#browse-path {
    height: auto;
    max-height: 2;
}

.narrow #parse-layout {
    layout: vertical;
}

.narrow #parse-controls, .narrow #preview-panel {
    width: 100%;
    padding: 0 1;
}

.narrow #parse-controls {
    height: auto;
    max-height: 11;
}

.narrow #preview-panel {
    height: 1fr;
}

.narrow #parse-controls Input {
    height: 1;
    border: none;
    padding: 0 1;
}

.narrow #parse-controls Input:focus {
    background: #354862;
}

.narrow #parse-controls Button, .narrow #parse-controls Button:focus {
    height: 1;
    border: none;
}

.narrow #parse-controls .buttons {
    margin-top: 1;
}

.narrow #preview-mode {
    width: 20;
}

.narrow #prompt {
    height: 4;
}
